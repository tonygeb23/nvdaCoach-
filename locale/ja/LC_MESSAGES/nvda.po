msgid "Unknown Category"
msgstr "不明なカテゴリー"

#: globalPlugins/nvdaCoach/__init__.py:1523
msgid "{completed} of {total} complete"
msgstr "{total} 個中 {completed} 個完了"

#: globalPlugins/nvdaCoach/__init__.py:1528
msgid "Untitled"
msgstr "無題"

#: globalPlugins/nvdaCoach/__init__.py:1531
msgid "[Done]"
msgstr "[完了]"

